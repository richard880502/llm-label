POSTGRES_PASSWORD=annotation-local-password
SECRET_KEY=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

DB_POOL_MIN_SIZE=4
DB_POOL_MAX_SIZE=40
DB_POOL_TIMEOUT_SECONDS=20

# Durable API task execution.
API_TASK_WORKERS=2
API_TASK_WATCHDOG_SECONDS=30

# LLM HTTP concurrency. The UI allows a single task concurrency of up to 100.
LLM_EXECUTOR_WORKERS=100
LLM_MAX_CONCURRENT_REQUESTS=100
LLM_HTTP_MAX_CONNECTIONS=128
LLM_HTTP_MAX_KEEPALIVE_CONNECTIONS=100
LLM_HTTP_KEEPALIVE_EXPIRY_SECONDS=30
LLM_MAX_RETRIES=3

GOOGLE_CLIENT_ID=
# MCP OAuth access tokens are independent from browser JWTs and expire after 60 minutes.
